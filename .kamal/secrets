# Referencias a los secretos, NO sus valores. Este archivo SE VERSIONA: si
# estuviera en .gitignore, el despliegue falla porque Kamal no lo encuentra
# dentro del runner de GitHub Actions.
#
# Cada nombre tiene que existir como secreto del repositorio
# (Settings -> Secrets and variables -> Actions) y estar exportado en el job de
# despliegue. Los secretos son por repositorio: no se heredan de otros
# proyectos del mismo servidor.
#
# Ninguno de estos valores pasa por el chat. Se generan y se cargan en el mismo
# comando.

# Token de GHCR. NO es un secreto que haya que crear: el workflow lo exporta
# desde ${{ secrets.GITHUB_TOKEN }}, que GitHub genera solo en cada ejecución y
# caduca al terminar. La línea se queda porque es así como Kamal resuelve el
# nombre que pide `registry.password`.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Cadena completa de conexión, con el rol propio del proyecto en el PostgreSQL
# compartido, nunca el superusuario:
#   postgresql://cesartravel:LACLAVE@postgres:5432/cesartravel
DATABASE_URL=$DATABASE_URL

# Firma de los JWT.
JWT_SECRET=$JWT_SECRET

# Contraseña del usuario admin que crea el seed en el primer arranque. Es la
# credencial REAL del panel, no un relleno.
SEED_ADMIN_PASSWORD=$SEED_ADMIN_PASSWORD
