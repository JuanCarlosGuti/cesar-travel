# Copiar a backend/.env (ignorado por git) y completar. En producción estas variables
# las inyecta la plataforma (Render las pide al desplegar), no hay archivo .env.

# Postgres de producción. Sin esta variable el backend usa SQLite en archivo, que es lo
# habitual en desarrollo: no hay que instalar nada.
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Clave de firma de los tokens de sesión. Generar con: openssl rand -base64 32
JWT_SECRET=cambiar-esto-en-produccion

# Vigencia del token (8h, 30m, 7d…)
JWT_EXPIRACION=8h

# Contraseña del anfitrión de demostración que crea el seed (anfitrion@canaguatetravel.com).
# Si no se define en producción, el seed genera una aleatoria y la muestra una única vez
# en los logs del arranque — nunca queda una credencial conocida en el repositorio.
SEED_ADMIN_PASSWORD=

# Puerto del servidor (la plataforma lo asigna en producción)
PORT=3000

# Orígenes permitidos para CORS, separados por coma. Vacío = sin CORS (mismo origen),
# que es lo correcto cuando el backend sirve el frontend.
CORS_ORIGENES=
